# CodeIgniter 4 specific files
/writable/cache/*
/writable/logs/*
/writable/session/*
/writable/uploads/*
/writable/debugbar/*

# Keep the directories but ignore contents
!/writable/cache/index.html
!/writable/logs/index.html
!/writable/session/index.html
!/writable/uploads/index.html
!/writable/debugbar/index.html

# Environment files
.env
.env.local
.env.production

# Composer
/vendor/
composer.lock

# Node modules (if using npm/yarn)
node_modules/
npm-debug.log
yarn-error.log

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backup files
*.bak
*.backup
*.tmp

# Database files
*.sqlite
*.sqlite3
*.db

# Log files
*.log

# Cache files
*.cache

# Build files
/build/
/dist/

# Testing
/tests/_output/
/tests/_support/_generated/

# PHPUnit
phpunit.xml
.phpunit.result.cache

# Coverage reports
/coverage/
clover.xml

# Temporary files
/temp/
/tmp/